{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "siso-sign",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "worker.js",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "cache": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "images": {
    "binding": "IMAGES"
  },
  "kv_namespaces": [
    {
      "binding": "VINEXT_KV_CACHE",
      "id": "74a841d53fcc4aa59e40ce0b35fd5414"
    }
  ],
  "account_id": "0af3820c996f277b2f17ee446d03f60a"
}
